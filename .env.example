# Development credentials only. Copy to .env for Docker Compose.
POSTGRES_USER=infrapulse
POSTGRES_PASSWORD=infrapulse_dev
POSTGRES_DB=infrapulse
POSTGRES_PORT=5432
HTTP_PORT=8080
GRPC_PORT=9443
DEFAULT_TELEPHONY_INTERVAL=30s
AUTH_MODE=required
AUTH_SESSION_TTL=8h
# Local Compose uses HTTP and publishes only loopback ports.
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:8080
AUTH_COOKIE_SECURE=false
# Both Backend and Agent/driver must explicitly permit typed mutations.
COMMANDS_ENABLED=false
COMMAND_ALLOW_DISABLE=false
COMMAND_ALLOW_ROLLBACK=false
COMMAND_PROTECTED_DEVICES=
COMMAND_PROTECTED_INTERFACES=
# Optional HTTPS enrollment and gRPC mTLS; see docs/stage8-pki.md.
PKI_ENABLED=false
PKI_ADDRESS=127.0.0.1:9444
PKI_CA_FILE=
PKI_CA_KEY_FILE=
PKI_TLS_CERT_FILE=
PKI_TLS_KEY_FILE=
PKI_CERT_LIFETIME=720h
# Rules operate on received telemetry; these do not change Agent intervals.
HEALTH_CPU_WARNING=80
HEALTH_CPU_CRITICAL=95
HEALTH_CPU_RECOVERY=70
HEALTH_RAM_WARNING=80
HEALTH_RAM_CRITICAL=95
HEALTH_RAM_RECOVERY=75
HEALTH_FORECAST_HORIZON_SECONDS=300
# External AI remains off until explicit configuration and per-preview consent.
AI_ENABLED=false
AI_MODEL=
AI_TIMEOUT=45s
OPENAI_API_KEY=
# Stable base64 of 32 random bytes. Required only when storing source credentials.
# Back up separately from PostgreSQL; never commit a real encryption key.
DATA_SOURCE_ENCRYPTION_KEY=
# External source HTTP defaults to deny. Set BOTH origins and destination CIDRs.
DATA_SOURCE_ALLOWED_ORIGINS=
DATA_SOURCE_ALLOWED_CIDRS=
DATA_SOURCE_ALLOW_LOOPBACK=false
# Optional deployment-only CA files, e.g. {"lab":"/run/source-ca/lab.pem"}.
# Mount the public CA file read-only; never a private key.
DATA_SOURCE_CA_FILES=
# Enable conservative automatic matching only after reviewing the demo dataset.
ASSET_AUTO_RESOLUTION_ENABLED=false
ASSET_RESOLUTION_MAX_AGE=24h

# B9: requires gRPC mTLS, REST auth and local Collector remote_management opt-in.
COLLECTOR_CONFIG_ENABLED=false

# B10: Linux Automation Worker, reviewed read-only templates only.
AUTOMATION_ENABLED=false
# Stable base64 32-byte key shared only by backend and worker. Back up separately.
AUTOMATION_ENCRYPTION_KEY=
AUTOMATION_WORKER_ID=worker_one
# Explicit device network allowlist, e.g. 192.0.2.0/24. Empty means no execution.
AUTOMATION_ALLOWED_CIDRS=

# B11.1: stale snapshots never claim current compliance.
CONFIGURATION_DRIFT_MAX_AGE=15m
