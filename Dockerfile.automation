FROM golang:1.27.1-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/automation-worker ./cmd/automation-worker

FROM python:3.13-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssh-client && rm -rf /var/lib/apt/lists/*
COPY configs/automation-requirements.txt /tmp/requirements.txt
COPY configs/automation-collections.yml /tmp/collections.yml
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt && ansible-galaxy collection install -r /tmp/collections.yml -p /usr/share/ansible/collections && rm /tmp/requirements.txt /tmp/collections.yml
RUN groupadd -g 10001 automation && useradd -u 10001 -g automation -m automation && install -d -m 0700 -o automation -g automation /work/jobs
COPY --from=build /out/automation-worker /app/automation-worker
USER automation
ENV AUTOMATION_PYTHON=/usr/local/bin/python AUTOMATION_WORK_DIR=/work/jobs AUTOMATION_CREDENTIALS_DIR=/run/automation-credentials
ENTRYPOINT ["/app/automation-worker"]
